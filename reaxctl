#!/usr/bin/env python3
"""reaxctl launcher. Command modules live in reaxlib/ and register themselves (see reaxlib/cli.py)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from reaxlib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
