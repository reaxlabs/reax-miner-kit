# Settings for service/docker-compose.s1-pro.yml; copy to miner.env and fill in. The hotkey file is mounted, not pasted.
REAX_NETWORK=finney
REAX_NETUID=92
REAX_WALLET_PATH=/wallets
REAX_WALLET_NAME=<coldkey name>
REAX_WALLET_HOTKEY=<hotkey name>
REAX_EXTERNAL_IP=<public ip of this machine>
REAX_EXTERNAL_PORT=8091
REAX_MINER_PORT=8091

# Leave probe limits unset to use this image's per-model defaults (also with reaxctl install):
# Pool     REAX_PER_CALLER_CONCURRENCY / REAX_PER_CALLER_PER_MINUTE / REAX_MAX_CONCURRENT / REAX_MAX_PENDING_PER_IP
# s1-pro   64 / 728 / 16 / 128
# s1-fast  64 / 888 / 16 / 128
# s1-lite, s1-cpu  32 / 456 / 8 / 64
# Several models: the first three limits apply per model; pending per IP is shared and follows the largest concurrency.
# Global overrides affect every model and can throttle a GPU model.
