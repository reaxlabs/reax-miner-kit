# Rendered by sn92-egress-render; do not edit the installed copy.
add table inet sn92_egress
flush table inet sn92_egress
table inet sn92_egress {
    set gateway4 { type ipv4_addr; elements = { @GATEWAY4@ } }
    set gateway6 { type ipv6_addr; elements = { @GATEWAY6@ } }
    set services4 { type ipv4_addr; elements = { @SERVICES4@ } }
    set services6 { type ipv6_addr; elements = { @SERVICES6@ } }
    chain input {
        type filter hook input priority filter; policy drop;
        iifname "lo" accept
        ct state established,related accept
        iifname "wg0" tcp dport { 8080, 8443 } accept
    }
    chain output {
        type filter hook output priority filter; policy drop;
        oifname "lo" accept
        ct state established,related accept
        ip daddr @gateway4 udp dport @WGPORT@ accept
        ip6 daddr @gateway6 udp dport @WGPORT@ accept
        ip daddr @services4 tcp dport { 80, 443 } accept
        ip6 daddr @services6 tcp dport { 80, 443 } accept
        oifname "wg0" accept
    }
    chain forward {
        type filter hook forward priority filter; policy drop;
        ct state established,related accept
        iifname "wg0" tcp dport 8080 accept
    }
}
